---
// The mark of semantic-warehouse-mcp — the favicon's (public/favicon.svg): a database with a label tied to it, on a
// dark indigo tile — the data, and what it means. The label is cut out of the cylinder by a ring of the tile's colour.
// A hairline ring keeps the tile's edge visible on a dark page. Decorative: the name always stands beside it.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  class={className}
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="32" height="32" rx="7" fill="#1e1b4b"></rect>
  <rect x="0.5" y="0.5" width="31" height="31" rx="6.5" fill="none" stroke="#ffffff" stroke-opacity="0.1"></rect>
  <g fill="none" stroke="#eef2ff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    <ellipse cx="12.5" cy="8.5" rx="7" ry="2.6"></ellipse>
    <path d="M5.5 8.5v14c0 1.44 3.13 2.6 7 2.6s7-1.16 7-2.6v-14"></path>
    <path d="M5.5 15.5c0 1.44 3.13 2.6 7 2.6s7-1.16 7-2.6"></path>
  </g>
  <path
    d="M15 20.75 19.25 16.5H26.5Q28 16.5 28 18V23.5Q28 25 26.5 25H19.25Z"
    fill="#818cf8"
    stroke="#1e1b4b"
    stroke-width="2.4"
    stroke-linejoin="round"
    paint-order="stroke"></path>
  <circle cx="19.7" cy="20.75" r="1.3" fill="#1e1b4b"></circle>
</svg>
